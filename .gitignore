# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
.idea/

# Config file
config.toml

# Local build toolchain, caches and authentication state
work/
dist/
nju-client-data.json
clash-nju.generated.yaml
clash-nju.generated.cfw-mixin.js

# Release archives and local credentials / diagnostics
releases/
*.zip
*.har
*.pcap
*.log
*.keylog
.env
.env.*
*.local.js
config.local.toml
__pycache__/

# Alternative session / diagnostic names and local IDE state
client_data*.json
client-data*.json
*session*.json
*.pem
*.pfx
*.p12
*.key
.ssh/
.vscode/
node_modules/
build_assets/
bin/
